<script>
(function () {
  var curso = document.getElementById('curso');
  if (!curso) return;
  curso.classList.add('js');

  var botoes = curso.querySelectorAll('.menu-botao');
  var paineis = curso.querySelectorAll('.painel');

  function fecharMenus(exceto) {
    botoes.forEach(function (b) { if (b !== exceto) b.setAttribute('aria-expanded', 'false'); });
  }

  function mostrarPainel(id, abrirBloco) {
    paineis.forEach(function (p) { p.classList.toggle('ativo', p.id === id); });
    if (abrirBloco) {
      var bloco = document.getElementById(abrirBloco);
      if (bloco) {
        bloco.closest('.painel').querySelectorAll('details').forEach(function (d) { d.open = false; });
        bloco.open = true;
        bloco.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
  }

  botoes.forEach(function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      var aberto = b.getAttribute('aria-expanded') === 'true';
      fecharMenus(b);
      b.setAttribute('aria-expanded', aberto ? 'false' : 'true');
    });
  });

  curso.querySelectorAll('.menu-lista a').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      mostrarPainel(a.dataset.alvo, a.dataset.abrir);
      fecharMenus(null);
    });
  });

  document.addEventListener('click', function () { fecharMenus(null); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var aberto = curso.querySelector('.menu-botao[aria-expanded="true"]');
      fecharMenus(null);
      if (aberto) aberto.focus();
    }
  });

  /* Carrossel do cabeçalho: muda de imagem a cada 60 segundos */
  var slides = curso.querySelectorAll('.slide');
  var pontos = curso.querySelectorAll('.pontos button');
  var atual = 0, relogio;
  function irPara(i) {
    slides[atual].classList.remove('ativo');
    pontos[atual].removeAttribute('aria-current');
    atual = (i + slides.length) % slides.length;
    slides[atual].classList.add('ativo');
    pontos[atual].setAttribute('aria-current', 'true');
  }
  function iniciar() {
    clearInterval(relogio);
    relogio = setInterval(function () { irPara(atual + 1); }, 60000);
  }
  pontos.forEach(function (b, i) {
    b.addEventListener('click', function () { irPara(i); iniciar(); });
  });
  iniciar();
})();
</script>
