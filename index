.pontos{position:absolute; right:14px; bottom:10px; z-index:2; display:flex; gap:8px}
.pontos button{width:12px; height:12px; padding:0; border:0; border-radius:50%; background:rgba(255,255,255,.4); cursor:pointer}
.pontos button[aria-current="true"]{background:#fff}
.pontos button:focus-visible{outline:3px solid var(--ambar); outline-offset:2px}
.curso:not(.js) .pontos{display:none}
@media (prefers-reduced-motion:reduce){.slide{transition:none}}
@media (max-width:640px){.curso-topo{padding:28px 16px 26px}.slide.ativo{opacity:.45}.curso-topo h1,.curso-topo p{max-width:100%}}
.curso-topo h1{margin:0 0 4px; font-size:1.65rem; line-height:1.2; color:#fff}
.curso-topo p{margin:0; color:#f8cfe0; font-size:.95rem}

/* Barra de menus */
.menu{display:flex; flex-wrap:wrap; background:var(--neblina); border-bottom:1px solid var(--linha); padding:0 12px}
.menu-item{position:relative}
.menu-botao{
  appearance:none; border:0; background:none; cursor:pointer; font:inherit; font-weight:600;
